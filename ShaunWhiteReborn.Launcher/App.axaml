<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Name="Shaun White Reborn"
             x:Class="ShaunWhiteReborn.Launcher.App"
             xmlns:local="using:ShaunWhiteReborn.Launcher"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>